ssageId":"unnecessaryAssertion","endLine":129,"endColumn":50,"fix":{"range":[3307,3334],"text":""}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":130,"column":11,"nodeType":"TSAsExpression","messageId":"unnecessaryAssertion","endLine":130,"endColumn":51,"fix":{"range":[3360,3387],"text":""}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":159,"column":22,"nodeType":"TSAsExpression","messageId":"unnecessaryAssertion","endLine":159,"endColumn":64,"fix":{"range":[4015,4042],"text":""}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":173,"column":23,"nodeType":"TSAsExpression","messageId":"unnecessaryAssertion","endLine":173,"endColumn":66,"fix":{"range":[4438,4465],"text":""}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":287,"column":20,"nodeType":"TSAsExpression","messageId":"unnecessaryAssertion","endLine":287,"endColumn":50,"fix":{"range":[7552,7579],"text":""}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":336,"column":18,"nodeType":"TSAsExpression","messageId":"unnecessaryAssertion","endLine":336,"endColumn":48,"fix":{"range":[8938,8965],"text":""}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":360,"column":13,"nodeType":"TSAsExpression","messageId":"unnecessaryAssertion","endLine":360,"endColumn":47,"
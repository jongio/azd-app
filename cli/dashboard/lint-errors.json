kip\r\n    React.useEffect(() => {\r\n      onSkip()\r\n    }, [onSkip])\r\n    return null\r\n  }\r\n\r\n  return (\r\n    <div className=\"space-y-3\">\r\n      {/* Header */}\r\n      <div className=\"flex items-center gap-2 text-blue-600 dark:text-blue-400\">\r\n        <Sparkles className=\"w-4 h-4\" />\r\n        <span className=\"text-xs font-medium\">\r\n          Pre-configured templates for {resourceType.displayName}\r\n        </span>\r\n      </div>\r\n\r\n      {/* Template Grid */}\r\n      <div className=\"grid grid-cols-2 gap-3\">\r\n        {templates.map((template) => (\r\n          <button\r\n            key={template.id}\r\n            type=\"button\"\r\n            onClick={() => onSelect(template)}\r\n            className={cn(\r\n              'flex items-start gap-3 p-4 rounded-lg border-2 transition-all text-left',\r\n              'border-slate-200 dark:border-slate-700',\r\n              'hover:border-cyan-500 hover:bg-cyan-50 dark:hover:bg-cyan-950/20',\r\n              'focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2'\r\n            )}\r\n          >\r\n            <span className=\"text-2xl shrink-0\" aria-hidden=\"true\">\r\n              {template.icon || resourceType.icon || '≡ƒôª'}\r\n            </span>\r\n            <div className=\"flex-1 min-w-0\">\r\n              <div className=\"font-semibold text-sm text-slate-900 dark:text-slate-100\">\r\n                {template.name}\r\n              </div>\r\n              <div className=\"text-xs text-slate-600 dark:text-slate-400 mt-0.5\">\r\n                {template.description}\r\n              </div>\r\n            </div>\r\n          </button>\r\n        ))}\r\n\r\n        {/* Custom/Skip Option */}\r\n        <button\r\n          type=\"button\"\r\n          onClick={onSkip}\r\n          className={cn(\r\n            'flex items-start gap-3 p-4 rounded-lg border-2 transition-all text-left',\r\n            'border-dashed border-slate-300 dark:border-slate-600',\r\n            'hover:border-cyan-500 hover:bg-cyan-50 dark:hover:bg-cyan-950/20',\r\n            'focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2'\r\n          )}\r\n        >\r\n          <span className=\"text-2xl shrink-0\" aria-hidden=\"true\">ΓÜÖ∩╕Å</span>\r\n          <div className=\"flex-1 min-w-0\">\r\n            <div className=\"font-semibold text-sm text-slate-900 dark:text-slate-100\">\r\n              Custom Configuration\r\n            </div>\r\n            <div className=\"text-xs text-slate-600 dark:text-slate-400 mt-0.5\">\r\n              Configure manually without a template\r\n            </div>\r\n          </div>\r\n        </button>\r\n      </div>\r\n    </div>\r\n  )\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\components\\editor\\modals\\ResourceTypeSelector.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\components\\editor\\modals\\RestoreConfirmationDialog.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\components\\editor\\modals\\RestoreConfirmationDialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\components\\editor\\modals\\ViewBackupModal.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unsafe-return","severity":2,"message":"Unsafe return of a value of type `any`.","line":173,"column":92,"nodeType":"TSAsExpression","messageId":"unsafeReturn","endLine":173,"endColumn":103},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2
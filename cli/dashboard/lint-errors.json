rce: 'bundled',\r\n      error: error instanceof Error ? error.message : String(error),\r\n    }\r\n  }\r\n}\r\n\r\n/**\r\n * Get bundled schema directly (synchronous)\r\n */\r\nexport function getBundledSchema(): Record<string, unknown> {\r\n  return bundledSchema\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\lib\\schema\\schema-parser.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\lib\\schema\\schema-parser.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\lib\\search-highlight.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\lib\\search-highlight.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\lib\\service-display.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\lib\\service-formatters.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\lib\\service-health.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"u
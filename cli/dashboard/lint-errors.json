lassName=\"block w-full text-left px-3 py-2 rounded-md hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors text-sm\"\r\n          >\r\n            <span className=\"font-medium text-slate-900 dark:text-slate-100\">Nginx</span>\r\n            <span className=\"text-slate-500 dark:text-slate-400 ml-2\">ΓåÆ nginx:alpine</span>\r\n          </button>\r\n          <button\r\n            type=\"button\"\r\n            onClick={() => {\r\n              setValue('image', 'redis:7-alpine')\r\n              setPortsInput('6379:6379')\r\n            }}\r\n            className=\"block w-full text-left px-3 py-2 rounded-md hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors text-sm\"\r\n          >\r\n            <span className=\"font-medium text-slate-900 dark:text-slate-100\">Redis</span>\r\n            <span className=\"text-slate-500 dark:text-slate-400 ml-2\">ΓåÆ redis:7-alpine</span>\r\n          </button>\r\n          <button\r\n            type=\"button\"\r\n            onClick={() => {\r\n              setValue('image', 'postgres:16-alpine')\r\n              setPortsInput('5432:5432')\r\n            }}\r\n            className=\"block w-full text-left px-3 py-2 rounded-md hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors text-sm\"\r\n          >\r\n            <span className=\"font-medium text-slate-900 dark:text-slate-100\">PostgreSQL</span>\r\n            <span className=\"text-slate-500 dark:text-slate-400 ml-2\">ΓåÆ postgres:16-alpine</span>\r\n          </button>\r\n          <button\r\n            type=\"button\"\r\n            onClick={() => {\r\n              setValue('image', 'mongo:7')\r\n              setPortsInput('27017:27017')\r\n            }}\r\n            className=\"block w-full text-left px-3 py-2 rounded-md hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors text-sm\"\r\n          >\r\n            <span className=\"font-medium text-slate-900 dark:text-slate-100\">MongoDB</span>\r\n            <span className=\"text-slate-500 dark:text-slate-400 ml-2\">ΓåÆ mongo:7</span>\r\n          </button>\r\n        </div>\r\n      </div>\r\n\r\n      {/* Submit Button */}\r\n      <div className=\"flex justify-end pt-4 border-t border-slate-200 dark:border-slate-700\">\r\n        <button\r\n          type=\"submit\"\r\n          disabled={isSubmitting}\r\n          className={cn(\r\n            'px-6 py-2.5 rounded-lg text-sm font-semibold shadow-sm',\r\n            'bg-cyan-600 text-white hover:bg-cyan-700',\r\n            'focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2',\r\n            'disabled:opacity-50 disabled:cursor-not-allowed',\r\n            'transition-colors duration-150'\r\n          )}\r\n        >\r\n          {isSubmitting ? 'Adding Service...' : 'Add Service'}\r\n        </button>\r\n      </div>\r\n    </form>\r\n  )\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\components\\editor\\modals\\DeleteBackupDialog.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\components\\editor\\modals\\DeleteBackupDialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\components\\editor\\modals\\DeleteServiceDialog.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\components\\editor\\modals\\DeleteServiceDialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\co
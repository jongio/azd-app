 data = await response.json()\r\n  return data.services || []\r\n}\r\n\r\n/**\r\n * Fetch specific well-known service by name\r\n */\r\nexport async function fetchWellKnownService(name: string): Promise<WellKnownService | null> {\r\n  const response = await fetch(`/api/editor/wellknown/${name}`)\r\n  \r\n  if (!response.ok) {\r\n    if (response.status === 404) {\r\n      return null\r\n    }\r\n    throw new Error(`Failed to fetch well-known service ${name}: HTTP ${response.status}: ${response.statusText}`)\r\n  }\r\n  \r\n  return await response.json()\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\lib\\azure-errors.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\lib\\azure-provenance.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\lib\\azure-provenance.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\lib\\codespace-utils.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\lib\\codespace-utils.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\code\\azd-app-2\\cli\\dashboard\\src\\lib\\constants.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":
# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf

# Web/frontend source
# The JS/TS toolchain (Astro, Vite, Prettier) and the website code generators
# always emit LF. Without an explicit eol, `* text=auto` checks these out as
# CRLF on Windows, so every generator or formatter run rewrites them and dirties
# the working tree. Pin to LF so the worktree matches what the tools produce.
*.astro text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Documentation
*.txt text eol=lf
LICENSE text eol=lf

# Lock files (preserve as-is)
*.lock binary

# Binary files
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.tgz binary

# Images (not expected but for completeness)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

{
  "name": "azd-app-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "validate": "tsx scripts/validate-commands.ts",
    "generate:cli": "tsx scripts/generate-cli-reference.ts",
    "generate:changelog": "tsx scripts/generate-changelog.ts",
    "prebuild": "pnpm validate && pnpm generate:cli && pnpm generate:changelog",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "screenshots": "tsx scripts/capture-screenshots.ts",
    "astro": "astro",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.4",
    "@jongio/azd-web-core": "^3.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.4",
    "astro-expressive-code": "^0.44.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "pagefind": "^1.5.2",
    "playwright": "^1.62.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1"
  },
  "pnpm": {
    "overrides": {
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1 <5",
      "svgo@>=4.0.0 <4.0.2": ">=4.0.2",
      "fast-uri@>=3.0.0 <=3.1.3": ">=3.1.4",
      "nanoid@<3.3.17": ">=3.3.17 <4",
      "postcss@<=8.5.17": ">=8.5.18"
    }
  }
}

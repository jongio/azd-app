---
import { Code } from 'astro-expressive-code/components';

interface Props {
  command: string;
  preHook: string;
  postHook: string;
  description: string;
  exampleYaml: string;
  envVars: Array<{
    name: string;
    description: string;
  }>;
}

const { command, preHook, postHook, description, exampleYaml, envVars } = Astro.props;
---

<!-- Lifecycle Hooks -->
<h2 class="text-2xl font-bold mt-12 mb-4">Lifecycle Hooks</h2>
<p class="text-neutral-700 dark:text-neutral-300 mb-4">
  The <code class="bg-neutral-200 dark:bg-neutral-700 px-2 py-1 rounded">{command}</code> command supports <code class="bg-neutral-200 dark:bg-neutral-700 px-2 py-1 rounded">{preHook}</code> and <code class="bg-neutral-200 dark:bg-neutral-700 px-2 py-1 rounded">{postHook}</code> hooks that {description}.
</p>

<h3 class="text-xl font-semibold mt-8 mb-4">Hook Configuration</h3>
<Code code={exampleYaml} lang="yaml" />

<h3 class="text-xl font-semibold mt-8 mb-4">Available Environment Variables</h3>
<div class="overflow-x-auto my-4">
  <table class="min-w-full text-sm rounded-lg overflow-hidden border border-neutral-200 dark:border-neutral-700">
    <thead>
      <tr class="bg-neutral-200 dark:bg-neutral-700">
        <th class="text-left py-3 px-4 font-semibold text-neutral-900 dark:text-neutral-100">Variable</th>
        <th class="text-left py-3 px-4 font-semibold text-neutral-900 dark:text-neutral-100">Description</th>
      </tr>
    </thead>
    <tbody class="bg-neutral-100 dark:bg-neutral-800">
      {envVars.map((envVar, index) => (
        <tr class={index > 0 ? "border-t border-neutral-200 dark:border-neutral-700" : ""}>
          <td class="py-3 px-4"><code class="text-blue-600 dark:text-blue-400 bg-transparent">{envVar.name}</code></td>
          <td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">{envVar.description}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

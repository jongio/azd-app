---
import Layout from '../../../components/Layout.astro';
---

<Layout title="What's New" description="Latest updates to azd-app CLI">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <!-- Header -->
    <div class="mb-12">
      <h1 class="text-4xl font-bold mb-4">What's New</h1>
      <p class="text-xl text-neutral-600 dark:text-neutral-400">
        Latest updates and features in the azd-app CLI extension.
      </p>
      <div class="mt-4">
        <a 
          href="/azd-app/reference/changelog/" 
          class="text-blue-600 dark:text-blue-400 hover:underline"
        >
          View full changelog →
        </a>
      </div>
    </div>

    <!-- Highlights -->
    <div class="mb-12 p-6 bg-linear-to-r from-blue-50 to-purple-50 dark:from-blue-900/20 dark:to-purple-900/20 rounded-lg border border-blue-200 dark:border-blue-800">
      <h2 class="text-xl font-bold mb-4">🎉 Recent Highlights</h2>
      <ul class="space-y-2 text-neutral-700 dark:text-neutral-300">
        <li class="flex items-start gap-2">
          <span class="text-green-500">✓</span>
          <span><strong>MCP Server</strong> - AI assistants can now debug your services</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-green-500">✓</span>
          <span><strong>Production Health Checks</strong> - Circuit breaker, rate limiting, caching</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-green-500">✓</span>
          <span><strong>Azure Functions & Logic Apps</strong> - Full support for serverless workloads</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-green-500">✓</span>
          <span><strong>Lifecycle Hooks</strong> - Run scripts before/after services start</span>
        </li>
      </ul>
    </div>

    <!-- Latest Releases -->
    <div class="space-y-8">
      
    <article class="mb-12 pb-8 border-b-2 border-blue-200 dark:border-blue-800">
      <header class="flex items-center gap-4 mb-4">
        <h2 class="text-2xl font-bold text-neutral-900 dark:text-white">
          v0.11.7
        </h2>
        <time class="text-sm text-neutral-500" datetime="2026-02-10">2026-02-10</time>
        <span class="px-2 py-1 text-xs font-medium bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 rounded">Latest</span>
      </header>
      <ul class="space-y-1">
        
        <li class="flex items-start gap-3 py-2">
          <span class="shrink-0 text-lg">📝</span>
          <span class="text-neutral-700 dark:text-neutral-300">style: improve layout and responsiveness of LogsPaneHeader component (<a href="https://github.com/jongio/azd-app/pull/127" class="text-blue-600 dark:text-blue-400 hover:underline" target="_blank">#127</a>) (<a href="https://github.com/jongio/azd-app/commit/a0c0d33" class="text-neutral-500 hover:underline" target="_blank">a0c0d33</a>)</span>
        </li>
        <li class="flex items-start gap-3 py-2">
          <span class="shrink-0 text-lg">📝</span>
          <span class="text-neutral-700 dark:text-neutral-300">Add retry logic for command execution in Build function (<a href="https://github.com/jongio/azd-app/pull/129" class="text-blue-600 dark:text-blue-400 hover:underline" target="_blank">#129</a>) (<a href="https://github.com/jongio/azd-app/commit/913645f" class="text-neutral-500 hover:underline" target="_blank">913645f</a>)</span>
        </li>
        <li class="flex items-start gap-3 py-2">
          <span class="shrink-0 text-lg">✨</span>
          <span class="text-neutral-700 dark:text-neutral-300">feat: add notification step for azd-extensions on release success (<a href="https://github.com/jongio/azd-app/commit/6b7ae42" class="text-neutral-500 hover:underline" target="_blank">6b7ae42</a>)</span>
        </li>
        <li class="flex items-start gap-3 py-2">
          <span class="shrink-0 text-lg">🔧</span>
          <span class="text-neutral-700 dark:text-neutral-300">chore: update registry for v0.11.6 (<a href="https://github.com/jongio/azd-app/commit/4c726ef" class="text-neutral-500 hover:underline" target="_blank">4c726ef</a>)</span>
        </li>
      </ul>
    </article>

    <article class="mb-12 ">
      <header class="flex items-center gap-4 mb-4">
        <h2 class="text-2xl font-bold text-neutral-900 dark:text-white">
          v0.11.6
        </h2>
        <time class="text-sm text-neutral-500" datetime="2026-02-08">2026-02-08</time>
        
      </header>
      <ul class="space-y-1">
        
        <li class="flex items-start gap-3 py-2">
          <span class="shrink-0 text-lg">🔧</span>
          <span class="text-neutral-700 dark:text-neutral-300">chore: update registry for v0.11.5 (<a href="https://github.com/jongio/azd-app/commit/8b248ba" class="text-neutral-500 hover:underline" target="_blank">8b248ba</a>)</span>
        </li>
      </ul>
    </article>

    <article class="mb-12 ">
      <header class="flex items-center gap-4 mb-4">
        <h2 class="text-2xl font-bold text-neutral-900 dark:text-white">
          v0.11.5
        </h2>
        <time class="text-sm text-neutral-500" datetime="2026-02-07">2026-02-07</time>
        
      </header>
      <ul class="space-y-1">
        
        <li class="flex items-start gap-3 py-2">
          <span class="shrink-0 text-lg">📝</span>
          <span class="text-neutral-700 dark:text-neutral-300">Update CLI documentation and changelog for v0.11.4 release (<a href="https://github.com/jongio/azd-app/pull/125" class="text-blue-600 dark:text-blue-400 hover:underline" target="_blank">#125</a>) (<a href="https://github.com/jongio/azd-app/commit/8a40d74" class="text-neutral-500 hover:underline" target="_blank">8a40d74</a>)</span>
        </li>
        <li class="flex items-start gap-3 py-2">
          <span class="shrink-0 text-lg">🔧</span>
          <span class="text-neutral-700 dark:text-neutral-300">chore: update registry for v0.11.4 (<a href="https://github.com/jongio/azd-app/commit/987bfb1" class="text-neutral-500 hover:underline" target="_blank">987bfb1</a>)</span>
        </li>
      </ul>
    </article>
    </div>

    <!-- CTA -->
    <div class="mt-12 p-6 bg-neutral-100 dark:bg-neutral-800 rounded-lg text-center">
      <h3 class="text-lg font-semibold mb-2">Ready to try it?</h3>
      <p class="text-neutral-600 dark:text-neutral-400 mb-4">
        Get started with the latest version of azd-app in minutes.
      </p>
      <a 
        href="/azd-app/quick-start/"
        class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors"
      >
        Quick Start Guide →
      </a>
    </div>
  </div>
</Layout>

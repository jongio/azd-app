---
import Layout from '../../components/Layout.astro';
import { Code } from 'astro-expressive-code/components';

const yamlQuickStart = `services:
  api:
    host: containerapp
    image: mcr.microsoft.com/dotnet/sdk:8.0
    local:
      credentials: azd`;

const runCommand = `# Authenticate with Azure (if not already)
azd auth login

# Start your services — credentials are forwarded automatically
azd app run`;

const yamlMultiService = `services:
  api:
    path: ./src/api
    language: dotnet
    local:
      credentials: azd

  worker:
    host: containerapp
    image: my-worker:latest
    local:
      credentials: azd

  postgres:
    host: containerapp
    image: postgres:16
    ports:
      - "5432:5432"
    # No credentials needed — postgres doesn't call Azure`;

const yamlFull = `services:
  api:
    host: containerapp
    image: mcr.microsoft.com/dotnet/sdk:8.0
    ports:
      - "8080:8080"
    env:
      AZURE_STORAGE_ACCOUNT: mystorageaccount
      AZURE_KEYVAULT_URL: https://myvault.vault.azure.net
    local:
      credentials: azd

  web:
    path: ./src/web
    language: node
    port: 3000
    env:
      API_URL: http://localhost:8080`;

const codeDotnet = `// No special configuration needed — just use DefaultAzureCredential
using Azure.Identity;
using Azure.Storage.Blobs;

var credential = new DefaultAzureCredential();
var blobClient = new BlobServiceClient(
    new Uri("https://mystorageaccount.blob.core.windows.net"),
    credential);

// This works identically on your host AND inside the container`;

const codePython = `# Works out of the box inside Docker with credential forwarding
from azure.identity import DefaultAzureCredential
from azure.storage.blob import BlobServiceClient

credential = DefaultAzureCredential()
blob_service = BlobServiceClient(
    account_url="https://mystorageaccount.blob.core.windows.net",
    credential=credential)`;

const codeNode = `// Same code works on host and in container
import { DefaultAzureCredential } from "@azure/identity";
import { BlobServiceClient } from "@azure/storage-blob";

const credential = new DefaultAzureCredential();
const blobService = new BlobServiceClient(
  "https://mystorageaccount.blob.core.windows.net",
  credential
);`;

const architectureDiagram = `Developer's machine (azd auth login)
    │
    ├── azd app run
    │     │
    │     ├── 1. Generates ephemeral mTLS certificates
    │     ├── 2. Starts mTLS auth server on localhost
    │     ├── 3. Cross-compiles azd CLI shim for Linux
    │     └── 4. For each service with local.credentials: azd
    │           ├── Volume-mounts shim as /usr/local/bin/azd
    │           ├── Volume-mounts certs at /run/secrets/azd-auth
    │           └── Injects AZD_AUTH_* env vars
    │
    └── Inside the container:
          DefaultAzureCredential
            → AzureDeveloperCliCredential
              → calls azd auth token (the shim)
                → mTLS POST to host auth server
                  → real azd auth token on host
                    → Azure AD token returned`;

const shimExample = `# Inside the container, this command "just works":
azd auth token --scope https://management.azure.com/.default

# The shim translates this into an mTLS request to the host:
# POST https://host.docker.internal:{port}/token
#   mTLS client cert: /run/secrets/azd-auth/client.crt
#   Body: {"scopes": ["https://management.azure.com/.default"]}`;

const troubleshootAuth = `# On your host machine, verify you're authenticated:
azd auth login
azd auth token --scope https://management.azure.com/.default

# If the above works, credential forwarding will work too`;

const troubleshootNetwork = `# Check that the container can reach the host:
docker exec -it <container-id> curl -v https://host.docker.internal:<port>/healthz

# On Linux, you may need to use the host gateway:
# --add-host=host.docker.internal:host-gateway`;

const troubleshootPermissions = `# Check certificate permissions inside the container:
docker exec -it <container-id> ls -la /run/secrets/azd-auth/

# Expected output:
# -r-------- 1 root root  ... client.crt
# -r-------- 1 root root  ... client.key
# -r-------- 1 root root  ... ca.crt`;

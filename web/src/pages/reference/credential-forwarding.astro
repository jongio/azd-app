    <!-- Future Roadmap -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4">Future Roadmap</h2>
      <div class="p-6 bg-blue-100 dark:bg-blue-900/40 rounded-lg border border-blue-300 dark:border-blue-700">
        <ul class="list-disc list-inside text-neutral-700 dark:text-neutral-300 space-y-2">
          <li><code class="px-2 py-1 bg-neutral-100 dark:bg-neutral-800 rounded">local.credentials: az</code> — Forward credentials using Azure CLI (<code class="px-1 bg-neutral-200 dark:bg-neutral-700 rounded">az login</code>) instead of azd</li>
          <li><code class="px-2 py-1 bg-neutral-100 dark:bg-neutral-800 rounded">local.credentials: auto</code> — Use DefaultAzureCredential on the host, trying all available credential sources automatically</li>

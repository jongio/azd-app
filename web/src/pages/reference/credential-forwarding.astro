              <td class="py-3 px-4 text-green-600 dark:text-green-400">1 volume mount</td>
              <td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">Exposes all Azure state, path-dependent</td>
            </tr>
            <tr class="border-t border-neutral-200 dark:border-neutral-700">
              <td class="py-3 px-4 font-semibold text-neutral-900 dark:text-neutral-100">Service principals</td>
              <td class="py-3 px-4 text-yellow-600 dark:text-yellow-400">Secrets in env vars or files</td>
              <td class="py-3 px-4 text-red-600 dark:text-red-400">Create app registration, manage secrets</td>
              <td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">Secrets expire, operational overhead</td>
            </tr>
            <tr class="border-t border-neutral-200 dark:border-neutral-700">
              <td class="py-3 px-4 font-semibold text-neutral-900 dark:text-neutral-100">Connection strings</td>
              <td class="py-3 px-4 text-red-600 dark:text-red-400">Secrets in plain text</td>

---
import Icon from '@jongio/azd-web-core/components/Icon.astro';
import Layout from '../../../components/Layout.astro';
import { Code } from 'astro-expressive-code/components';
const usageCode = "azd app remove <service>";
const example0 = "azd app remove <service>";
const example1 = "azd app remove redis";
const example2 = "azd app remove redis --output json";
---
import Icon from '@jongio/azd-web-core/components/Icon.astro';

<Layout title="remove - CLI Reference" description="Remove a service from the `services` section of `azure.yaml`.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm mb-8">
      <ol class="flex items-center gap-2 text-neutral-500">
        <li><a href="/azd-app/" class="hover:text-blue-500">Home</a></li>
        <li>/</li>
        <li><a href="/azd-app/reference/cli/" class="hover:text-blue-500">CLI Reference</a></li>
        <li>/</li>
        <li class="text-neutral-900 dark:text-white">remove</li>
      </ol>
    </nav>

    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-4">azd app remove</h1>
      <p class="text-xl text-neutral-700 dark:text-neutral-300">Remove a service from the `services` section of `azure.yaml`.</p>
    </div>

    <h2 class="text-2xl font-bold mt-8 mb-4">Usage</h2>
    <Code code={usageCode} lang="bash" frame="terminal" />

    

    <h2 class="text-2xl font-bold mt-12 mb-6">Examples</h2><div class="space-y-4"><Code code={example0} lang="bash" frame="terminal" />
  <Code code={example1} lang="bash" frame="terminal" />
  <Code code={example2} lang="bash" frame="terminal" /></div>

    <div class="mt-12 p-6 bg-blue-100 dark:bg-blue-900/40 rounded-lg border border-blue-300 dark:border-blue-700"><h3 class="text-lg font-semibold mb-2 text-neutral-900 dark:text-neutral-100"><Icon name="book-open" /> Detailed Documentation</h3><p class="text-neutral-700 dark:text-neutral-300 mb-4">For complete documentation including flows, diagrams, and advanced usage, see the full command specification.</p><a href="https://github.com/jongio/azd-app/blob/main/cli/docs/commands/remove.md" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-blue-700 dark:text-blue-400 hover:underline">View full remove specification →</a></div>

    <div class="mt-12 pt-8 border-t border-neutral-200 dark:border-neutral-700">
      <div class="flex justify-between">
        <a href="/azd-app/reference/cli/" class="text-blue-600 dark:text-blue-400 hover:underline">
          ← Back to CLI Reference
        </a>
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll('.copy-button').forEach(button => {
      button.addEventListener('click', async () => {
        const code = button.getAttribute('data-code');
        if (code) {
          await navigator.clipboard.writeText(code);
          button.textContent = 'Copied!';
          setTimeout(() => { button.textContent = 'Copy'; }, 2000);
        }
      });
    });
  </script>
</Layout>

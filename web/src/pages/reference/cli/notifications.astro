---
import Icon from '@jongio/azd-web-core/components/Icon.astro';
import Layout from '../../../components/Layout.astro';
import { Code } from 'astro-expressive-code/components';
const usageCode = "azd app notifications [command]";
const example0 = "azd app notifications [command]";
const example1 = "azd app notifications list";
const example2 = "azd app notifications list --unread";
const example3 = "azd app notifications list --service api";
const example4 = "azd app notifications mark-read --all";
const example5 = "azd app notifications clear --older-than 168h";
const example6 = "azd app notifications stats";
const example7 = "azd app notifications test";
const example8 = "azd app notifications enable";
const example9 = "azd app notifications enable --disable";
---
import Icon from '@jongio/azd-web-core/components/Icon.astro';

<Layout title="notifications - CLI Reference" description="View and manage notifications for service state changes and events.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm mb-8">
      <ol class="flex items-center gap-2 text-neutral-500">
        <li><a href="/azd-app/" class="hover:text-blue-500">Home</a></li>
        <li>/</li>
        <li><a href="/azd-app/reference/cli/" class="hover:text-blue-500">CLI Reference</a></li>
        <li>/</li>
        <li class="text-neutral-900 dark:text-white">notifications</li>
      </ol>
    </nav>

    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-4">azd app notifications</h1>
      <p class="text-xl text-neutral-700 dark:text-neutral-300">View and manage notifications for service state changes and events.</p>
    </div>

    <h2 class="text-2xl font-bold mt-8 mb-4">Usage</h2>
    <Code code={usageCode} lang="bash" frame="terminal" />

    <h2 class="text-2xl font-bold mt-12 mb-4">Flags</h2><div class="overflow-x-auto my-8"><table class="min-w-full text-sm rounded-lg overflow-hidden border border-neutral-200 dark:border-neutral-700"><thead><tr class="bg-neutral-200 dark:bg-neutral-700"><th class="text-left py-3 px-4 font-semibold text-neutral-900 dark:text-neutral-100">Flag</th><th class="text-left py-3 px-4 font-semibold text-neutral-900 dark:text-neutral-100">Short</th><th class="text-left py-3 px-4 font-semibold text-neutral-900 dark:text-neutral-100">Type</th><th class="text-left py-3 px-4 font-semibold text-neutral-900 dark:text-neutral-100">Default</th><th class="text-left py-3 px-4 font-semibold text-neutral-900 dark:text-neutral-100">Description</th></tr></thead><tbody class="bg-neutral-100 dark:bg-neutral-800"><tr class="border-t border-neutral-200 dark:border-neutral-700"><td class="py-3 px-4"><code class="text-blue-600 dark:text-blue-400 bg-transparent">--unread</code></td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">-</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">bool</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">false</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">Show only unread notifications</td></tr><tr class="border-t border-neutral-200 dark:border-neutral-700"><td class="py-3 px-4"><code class="text-blue-600 dark:text-blue-400 bg-transparent">--service</code></td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">-</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">string</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">-</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">Filter by service name</td></tr><tr class="border-t border-neutral-200 dark:border-neutral-700"><td class="py-3 px-4"><code class="text-blue-600 dark:text-blue-400 bg-transparent">--limit</code></td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">-</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">int</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">50</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">Maximum number of notifications to show</td></tr><tr class="border-t border-neutral-200 dark:border-neutral-700"><td class="py-3 px-4"><code class="text-blue-600 dark:text-blue-400 bg-transparent">--all</code></td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">-</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">bool</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">false</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">Mark all notifications as read</td></tr><tr class="border-t border-neutral-200 dark:border-neutral-700"><td class="py-3 px-4"><code class="text-blue-600 dark:text-blue-400 bg-transparent">--older-than</code></td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">-</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">string</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">-</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">Clear notifications older than duration (for example, `24h` or `7d`)</td></tr><tr class="border-t border-neutral-200 dark:border-neutral-700"><td class="py-3 px-4"><code class="text-blue-600 dark:text-blue-400 bg-transparent">--yes</code></td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">-</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">bool</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">false</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">Clear all notification history without prompting</td></tr><tr class="border-t border-neutral-200 dark:border-neutral-700"><td class="py-3 px-4"><code class="text-blue-600 dark:text-blue-400 bg-transparent">--disable</code></td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">-</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">bool</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">false</td><td class="py-3 px-4 text-neutral-700 dark:text-neutral-300">Disable OS notifications instead of enabling</td></tr></tbody></table></div>

    <h2 class="text-2xl font-bold mt-12 mb-6">Examples</h2><div class="space-y-4"><Code code={example0} lang="bash" frame="terminal" />
  <Code code={example1} lang="bash" frame="terminal" />
  <Code code={example2} lang="bash" frame="terminal" />
  <Code code={example3} lang="bash" frame="terminal" />
  <Code code={example4} lang="bash" frame="terminal" />
  <Code code={example5} lang="bash" frame="terminal" />
  <Code code={example6} lang="bash" frame="terminal" />
  <Code code={example7} lang="bash" frame="terminal" />
  <Code code={example8} lang="bash" frame="terminal" />
  <Code code={example9} lang="bash" frame="terminal" /></div>

    <div class="mt-12 p-6 bg-blue-100 dark:bg-blue-900/40 rounded-lg border border-blue-300 dark:border-blue-700"><h3 class="text-lg font-semibold mb-2 text-neutral-900 dark:text-neutral-100"><Icon name="book-open" /> Detailed Documentation</h3><p class="text-neutral-700 dark:text-neutral-300 mb-4">For complete documentation including flows, diagrams, and advanced usage, see the full command specification.</p><a href="https://github.com/jongio/azd-app/blob/main/cli/docs/commands/notifications.md" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-blue-700 dark:text-blue-400 hover:underline">View full notifications specification →</a></div>

    <div class="mt-12 pt-8 border-t border-neutral-200 dark:border-neutral-700">
      <div class="flex justify-between">
        <a href="/azd-app/reference/cli/" class="text-blue-600 dark:text-blue-400 hover:underline">
          ← Back to CLI Reference
        </a>
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll('.copy-button').forEach(button => {
      button.addEventListener('click', async () => {
        const code = button.getAttribute('data-code');
        if (code) {
          await navigator.clipboard.writeText(code);
          button.textContent = 'Copied!';
          setTimeout(() => { button.textContent = 'Copy'; }, 2000);
        }
      });
    });
  </script>
</Layout>
